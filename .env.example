# ═══════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL ENTORNO - Copia este archivo como ".env" (sin .example)
# ═══════════════════════════════════════════════════════════════════

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────
# OPCIÓN 1: Base de Datos Local (Desarrollo)
# ─────────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=biblioteca_db
DB_HOST=127.0.0.1
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────────
# OPCIÓN 2: Base de Datos en la Nube (Render, Railway, etc.)
# Descomenta y reemplaza con tu DATABASE_URL de Render
# ─────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

